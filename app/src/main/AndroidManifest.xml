<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name="com.qrcode.scanner.QrScannerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_launcher"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRCodeScanner">
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- AppCompat persists application locales on API &lt; 33. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name="com.qrcode.scanner.MainActivity"
            android:exported="true"
            android:label="@string/main_app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.qrcode.scanner.launcher.activities.WelcomeBackActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Onboarding" />
        <activity
            android:name="com.qrcode.scanner.launcher.activities.LanguageActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Onboarding" />
        <activity
            android:name="com.qrcode.scanner.launcher.activities.CollectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Onboarding" />
        <activity
            android:name="com.qrcode.scanner.launcher.activities.PermissionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Onboarding" />
        <activity
            android:name="com.qrcode.scanner.launcher.activities.IntroActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Onboarding" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.create.CreateActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.create.CommonQrFormActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.create.WifiQrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.create.QrPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.create.QrCustomizationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.scan.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.scan.ContinuousBatchResultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.scan.ScanResultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.scan.GalleryCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.scan.DetectionErrorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.history.FavoritesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.history.HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />
        <activity
            android:name="com.qrcode.scanner.ui.screens.history.HistoryDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRCodeScanner" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

    </application>

</manifest>
