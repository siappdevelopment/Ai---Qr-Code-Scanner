<?xml version="1.0" encoding="utf-8"?>
<!-- "Welcome back" screen: title, logo, app name, Continue (counts down first) and a medium native ad at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/_40sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sans_trial_semi_bold"
            android:includeFontPadding="false"
            android:text="@string/welcome_back_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_22sdp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_round" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/sans_trial_medium"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_14sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWelcomeContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22sdp"
            android:background="@drawable/bg_welcome_continue"
            android:fontFamily="@font/sans_trial_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="@dimen/_110sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/welcome_back_continue"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

    <!-- medium native at the bottom -->
    <RelativeLayout
        android:id="@+id/rlWelcomeAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerWelcomeAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.9"
            app:shimmer_highlight_alpha="1.0">

            <include layout="@layout/shimmer_medium_ad" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <FrameLayout
            android:id="@+id/flWelcomeAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </RelativeLayout>

</LinearLayout>
