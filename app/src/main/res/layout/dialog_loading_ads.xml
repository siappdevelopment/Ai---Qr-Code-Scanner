<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/custom_radius_16"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="@dimen/_32sdp"
        android:indeterminateTint="@color/primary"
        android:indeterminateTintMode="src_in" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:fontFamily="@font/sans_trial_semi_bold"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/loading_ads_title"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/_14sdp"
        tools:ignore="HardcodedText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/sans_trial_regular"
        android:gravity="center"
        android:text="@string/loading_ads_desc"
        android:textColor="?attr/textSecondaryColor"
        android:textSize="@dimen/_11sdp"
        tools:ignore="HardcodedText" />

</LinearLayout>