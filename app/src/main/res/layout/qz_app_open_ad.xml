<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llQZClose"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@drawable/custom_round_left"
        android:gravity="center_vertical"
        android:padding="@dimen/_10sdp">

        <RelativeLayout
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/qzShimmerIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/surfaceSecondaryColor"
                android:visibility="gone"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_highlight_alpha="1.0">

                <include layout="@layout/qz_shimmer" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivQZAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/sans_trial_medium"
            android:gravity="center"
            android:paddingBottom="@dimen/_1sdp"
            android:text="Continue to app"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/_12sdp"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_arrow" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="@dimen/_20sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_weight="1">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/qzShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:visibility="gone"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_highlight_alpha="1.0">

                <include layout="@layout/qz_shimmer_app_open" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQZAppMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnQZClick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/custom_radius_12"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/sans_trial_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:singleLine="true"
            android:text="Click Here"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_12sdp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>