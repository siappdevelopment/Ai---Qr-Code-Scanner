<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors native_medium_ad_layout (Google) — same structure/sizing; Quiz view ids only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ad_background"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/_125sdp"
            android:layout_weight="1">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/qzShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ad_background"
                android:visibility="gone"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="1.0"
                app:shimmer_highlight_alpha="1.0">

                <include layout="@layout/qz_shimmer" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQZAppMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQZLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_label"
                android:fontFamily="@font/sans_trial_medium"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_1sdp"
                android:text="AD"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_7sdp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <RelativeLayout
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/qzShimmerIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/ad_background"
                        android:visibility="gone"
                        app:shimmer_auto_start="false"
                        app:shimmer_base_alpha="1.0"
                        app:shimmer_highlight_alpha="1.0">

                        <include layout="@layout/qz_shimmer" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivQZAppIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/sans_trial_medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="Ad Headline"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_11sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQZAppDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/sans_trial_regular"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="Ad Body"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnQZClick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/custom_radius_12"
        android:backgroundTint="@color/primary"
        android:elevation="0dp"
        android:ellipsize="end"
        android:fontFamily="@font/sans_trial_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:stateListAnimator="@null"
        android:text="Install"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_12sdp"
        tools:ignore="HardcodedText" />

</LinearLayout>
